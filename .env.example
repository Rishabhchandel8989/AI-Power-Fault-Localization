# ============================================================
# .env.example — copy to .env and fill in for local dev
# Docker Compose does NOT need this file; it uses its own
# environment: block in docker-compose.yml.
# ============================================================

# --- MySQL (used by Docker Compose) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=powerfault

# --- Spring Boot Backend (Docker Compose injects these) ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/powerfault?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Local development override (edit application.properties for local dev) ---
# LOCAL_DB_URL=jdbc:mysql://localhost:3306/power_fault_db
# LOCAL_DB_USERNAME=root
# LOCAL_DB_PASSWORD=<your-local-mysql-password>
