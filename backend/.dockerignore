target
.idea
*.iml
.git

version: "3.9"

services:

  mysql:
    image: mysql:8.4
    container_name: powerfault-mysql

    restart: always

    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: powerfault

    ports:
      - "3306:3306"

    volumes:
      - mysql-data:/var/lib/mysql

  backend:
    build:
      context: ./backend

    container_name: powerfault-backend

    depends_on:
      - mysql

    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://mysql:3306/powerfault
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: root

    ports:
      - "8080:8080"

  frontend:
    build:
      context: ./frontend

    container_name: powerfault-frontend

    depends_on:
      - backend

    ports:
      - "5173:5173"

volumes:
  mysql-data: